{
  "name": "ribbon",
  "version": "0.1.0",
  "private": true,
  "description": "Ribbon: every gift on your list, tied to one PayPal approval. An AI gift-shopping agent with per-person envelopes under one PayPal authorization.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "node scripts/build-web.mjs",
    "test": "vitest run server",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "video": "node scripts/video/run.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.111",
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@ai-sdk/provider": "^4.0.35",
    "@paypal/agent-toolkit": "^1.11.0",
    "ai": "^7.0.162",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
