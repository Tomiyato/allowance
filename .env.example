# Allowance configuration. Copy to .env and fill in. Never commit .env.

# --- AI --------------------------------------------------------------------
# Google AI Studio -> Get API key. Used for the shopping agent and mandate parsing.
GEMINI_API_KEY=
# google (default) | groq
AI_PROVIDER=google
# Model id. Default: gemini-3.8-flash (google) or openai/gpt-oss-120b (groq).
AI_MODEL=
# Groq fallback (OpenAI-compatible, https://api.groq.com/openai/v1). Only needed with AI_PROVIDER=groq.
GROQ_API_KEY=

# --- PayPal (sandbox) ------------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox
# mock | authorization | per_purchase   (vault: planned, falls back to authorization)
# Default: authorization when PayPal keys are set, otherwise mock (no real money, labeled MOCK in the UI).
PAYMENT_MODE=mock

# --- Products --------------------------------------------------------------
# trychannel3.com -> Developer -> API key (1,000 free searches/month)
CHANNEL3_API_KEY=
# channel3 | catalog. Default: channel3 when CHANNEL3_API_KEY is set. Channel3 errors fall back to the catalog.
PRODUCT_SOURCE=channel3
# 1 = mix the prompt-injection demo listing into garden/gift results
DEMO_INJECTION=1

# --- Server ----------------------------------------------------------------
# Public base URL used for PayPal return links, e.g. https://allowance.onrender.com
# Default: derived from the incoming request (fine for localhost).
PUBLIC_URL=
# Port (Render sets this automatically).
PORT=3000
# Optional JSON file for session persistence (best effort; default .data/store.json).
STORE_FILE=
