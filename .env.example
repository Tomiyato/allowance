# Ribbon configuration. Copy to .env and fill in. Never commit .env.

# --- AI --------------------------------------------------------------------
# Google AI Studio -> Get API key. Used for the gift-shopping agent and for turning the gift list text into envelopes.
GEMINI_API_KEY=
# google (default) | groq
AI_PROVIDER=google
# Model id, or a comma-separated chain. Default: gemini-3.8-flash (google) or openai/gpt-oss-120b (groq),
# followed by the fallback chain (other Gemini flash models, then Groq gpt-oss).
AI_MODEL=
# Groq (OpenAI-compatible, https://api.groq.com/openai/v1): the Groq models at the end of the fallback chain,
# or the primary with AI_PROVIDER=groq. AI_FALLBACK_MODEL=provider:model,... replaces the chain; AI_FALLBACK=off disables it.
GROQ_API_KEY=

# --- PayPal (sandbox) ------------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox
# mock | authorization | per_purchase   (vault: planned, falls back to authorization)
# Default: authorization when PayPal keys are set, otherwise mock (no real money, labeled MOCK in the UI).
PAYMENT_MODE=mock

# --- Products --------------------------------------------------------------
# trychannel3.com -> Developer -> API key (1,000 free searches/month)
CHANNEL3_API_KEY=
# channel3 | catalog. Default: channel3 when CHANNEL3_API_KEY is set. Channel3 errors fall back to the catalog.
PRODUCT_SOURCE=channel3
# 1 = mix the prompt-injection demo listing into garden/gift results (the red-team demo works without it)
DEMO_INJECTION=1

# --- Server ----------------------------------------------------------------
# Public base URL used for PayPal return links, e.g. https://allowance-cpp0.onrender.com (the hosted demo)
# Default: derived from the incoming request (fine for localhost).
PUBLIC_URL=
# Port (Render sets this automatically).
PORT=3000
# Optional JSON file for session persistence (best effort; default .data/store.json).
STORE_FILE=
